---
import RequestTable from "../../components/RequestTable.astro";
import Layout from "../../layouts/Layout.astro";
import { requestsForCentral } from "../../lib/db";
import { getSession } from "../../lib/session";

const session = getSession(Astro.cookies);
if (session?.kind !== "central") return Astro.redirect("/");

const all = requestsForCentral();
const pending = all.filter((r) => r.status === "pending");
---

<Layout title="ECA queue">
  <h1>Extenuating Circumstances Applications</h1>
  <p class="lede">
    Signed in as <strong>CENTRAL</strong>, the central team. Every ECA comes here and nowhere else. Course staff
    never see these applications or their documents.
  </p>
  <p class="live-banner callout central" id="live" hidden>New applications have arrived. <a href="/central/">Refresh</a>.</p>

  <h2>Waiting for a decision ({pending.length})</h2>
  <RequestTable rows={pending} showStudent empty="No applications waiting." />

  <h2>All applications</h2>
  <RequestTable rows={all} showStudent empty="No applications yet." />
</Layout>

<script>
  const banner = document.querySelector<HTMLElement>("#live");
  const source = new EventSource("/api/events");
  source.addEventListener("message", (event) => {
    if (banner && JSON.parse(event.data).kind === "eca") banner.hidden = false;
  });
</script>
